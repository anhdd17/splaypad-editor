<mxfile><diagram name="rope"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="&lt;b&gt;&quot;orld&quot;&lt;/b&gt;&lt;br&gt;size 15 · nl 2&lt;br&gt;own_nl 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#256abf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="130" height="60" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;&quot;lo\nw&quot;&lt;/b&gt;&lt;br&gt;size 7 · nl 1&lt;br&gt;own_nl 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#256abf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="130" height="60" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;&quot;\nfoo&quot;&lt;/b&gt;&lt;br&gt;size 4 · nl 1&lt;br&gt;own_nl 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#256abf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="130" height="60" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;&quot;hel&quot;&lt;/b&gt;&lt;br&gt;size 3 · nl 0&lt;br&gt;own_nl 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#256abf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="130" height="60" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v2" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v9" value="Nội dung: &lt;b&gt;hel · lo\nw · orld · \nfoo&lt;/b&gt; (thứ tự in-order)&lt;br&gt;&lt;br&gt;Tìm byte ở vị trí 9 (từ gốc):&lt;br&gt;• 9 ≥ size(trái) = 7 → bỏ qua cây trái, còn 9 − 7 = 2&lt;br&gt;• 2 &amp;lt; len(&quot;orld&quot;) = 4 → byte thứ 2 của &quot;orld&quot; là &lt;b&gt;l&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tìm đầu dòng 2 (sau '\n' thứ 2):&lt;br&gt;• nl(trái) = 1 &amp;lt; 2, own_nl(gốc) = 0 → sang phải, còn k = 1&lt;br&gt;• '\n' đầu của &quot;\nfoo&quot; → offset 7 + 4 + 0 + 1 = 12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="380" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
